{
  "name": "streamboxx",
  "version": "0.1.0",
  "private": true,
  "description": "An original streaming-style desktop app starter",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "electron:prod-preview": "pnpm run build && node electron/start-production.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.5",
    "hls.js": "1.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "wait-on": "9.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}
